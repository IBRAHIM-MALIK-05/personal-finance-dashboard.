# Copy this file to .env (same folder: backend/) and fill in YOUR password.
# .env is ignored by Git, so the password never ends up in the repository.
#
# The app database (created by database/setup_mysql.sql in MySQL Workbench):
DATABASE_URL=mysql+pymysql://hci_app:CHANGE_ME@localhost:3306/hci_finance?charset=utf8mb4
#
# Separate schema for the MySQL integration tests (it is wiped on every test run):
TEST_DATABASE_URL=mysql+pymysql://hci_app:CHANGE_ME@localhost:3306/hci_finance_test?charset=utf8mb4
#
# Signs log-in sessions. Leave it out and the app creates one here on first run.
# SECRET_KEY=
