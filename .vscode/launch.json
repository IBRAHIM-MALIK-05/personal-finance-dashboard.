{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/source/app.py",
      "cwd": "${workspaceFolder}/source",
      "python": "${workspaceFolder}/source/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run the app (reset demo data first)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/source/app.py",
      "args": ["--reset"],
      "cwd": "${workspaceFolder}/source",
      "python": "${workspaceFolder}/source/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    }
  ]
}
